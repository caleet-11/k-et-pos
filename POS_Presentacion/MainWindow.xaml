<Window x:Class="POS_Presentacion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Alta Rápida de Producto" Height="500" Width="450" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="15"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="20">
        <materialDesign:Card Padding="25" UniformCornerRadius="10" Background="White" VerticalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                    <materialDesign:PackIcon Kind="PackageVariantPlus" Width="28" Height="28" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Registrar Producto" FontSize="22" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtCodigo" Grid.Column="0" FontSize="16" Height="45"
                             materialDesign:HintAssist.Hint="Código (Escáner o Interno)" 
                             materialDesign:HintAssist.IsFloating="True" VerticalAlignment="Bottom"/>

                    <Button x:Name="btnGenerarCodigo" Grid.Column="2" Content="GENERAR CÓDIGO" 
                            Background="Transparent" BorderBrush="{DynamicResource PrimaryHueMidBrush}" Foreground="{DynamicResource PrimaryHueMidBrush}" 
                            Height="40" Click="BtnGenerarCodigo_Click" VerticalAlignment="Bottom" materialDesign:ButtonAssist.CornerRadius="5"/>
                </Grid>

                <TextBox x:Name="txtNombre" FontSize="16" Height="45" Margin="0,0,0,25" 
                         materialDesign:HintAssist.Hint="Nombre del Artículo" 
                         materialDesign:HintAssist.IsFloating="True"/>

                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtPrecioCosto" Grid.Column="0" FontSize="16" Height="45"
                             materialDesign:HintAssist.Hint="Precio Costo ($)" 
                             materialDesign:HintAssist.IsFloating="True"/>

                    <TextBox x:Name="txtPrecioVenta" Grid.Column="2" FontSize="16" Height="45"
                             materialDesign:HintAssist.Hint="Precio Venta ($)" 
                             materialDesign:HintAssist.IsFloating="True"/>
                </Grid>

                <CheckBox x:Name="chkSeVendePorUnidad" Content="Se vende por pieza (Desmarcar para granel)" IsChecked="True" FontSize="14" Margin="0,5,0,30"/>

                <Button x:Name="btnGuardar" Height="50" Background="#2E7D32" BorderBrush="#2E7D32" Foreground="White" Click="BtnGuardar_Click" materialDesign:ButtonAssist.CornerRadius="5">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="GUARDAR PRODUCTO" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>