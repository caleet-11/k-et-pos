<Window x:Class="POS_Presentacion.ClientesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Gestión de Clientes y Cuentas por Cobrar" Height="700" Width="1100" WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}" FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <materialDesign:Card Grid.Column="0" UniformCornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="txtBuscarCliente" Grid.Row="0" FontSize="16" Height="45" Margin="0,0,0,15"
                         materialDesign:HintAssist.Hint="🔍 Buscar cliente..." 
                         materialDesign:HintAssist.IsFloating="True"
                         TextChanged="TxtBuscarCliente_TextChanged"/>

                <DataGrid x:Name="dgClientes" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                          SelectionChanged="DgClientes_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Deuda" Binding="{Binding DeudaActual, StringFormat=C}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Column="2" UniformCornerRadius="8" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="lblNombreCliente" Grid.Row="0" Text="Selecciona un cliente" FontSize="24" FontWeight="Bold" Foreground="#333" Margin="0,0,0,5"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,10" HorizontalAlignment="Right" Width="541">
                    <TextBlock Text="Deuda Total: " FontSize="18" Foreground="Gray" VerticalAlignment="Bottom"/>
                    <TextBlock x:Name="lblDeudaTotal" Text="$0.00" FontSize="32" FontWeight="Bold" Foreground="#D32F2F" VerticalAlignment="Bottom" RenderTransformOrigin="0.487,1.086" Height="32"/>
                </StackPanel>

                <DataGrid x:Name="dgTickets" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" 
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" Margin="0,0,0,15">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="100" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Fecha y Hora" Binding="{Binding FechaHora, StringFormat=dd/MM/yyyy HH:mm}" Width="*"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding EstadoPago}" Width="100"/>
                        <DataGridTextColumn Header="Total a Pagar" Binding="{Binding Total, StringFormat=C}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1976D2"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Button x:Name="btnNuevoCliente" FocusVisualStyle="{x:Null}" Background="#198754" BorderBrush="#198754" Foreground="White" Height="45" Click="BtnNuevoCliente_Click" materialDesign:ButtonAssist.CornerRadius="8" Style="{StaticResource MaterialDesignRaisedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Register" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Registrar Cliente" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnAbonar" Grid.Row="3" Content="💵 ABONAR / LIQUIDAR DEUDA" 
                        Background="#2E7D32" BorderBrush="#2E7D32" Foreground="White" Height="55" FontSize="16" FontWeight="Bold"
                        IsEnabled="False" Click="BtnAbonar_Click" materialDesign:ButtonAssist.CornerRadius="8"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>