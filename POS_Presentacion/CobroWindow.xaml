<Window x:Class="POS_Presentacion.CobroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Procesar Pago" Height="620" Width="628" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="15"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
            <RadioButton x:Name="rbEfectivo" Content="💵 EFECTIVO" FontSize="14" FontWeight="SemiBold" Margin="0,0,15,0" Checked="MetodoPago_Checked"/>
            <RadioButton x:Name="rbTarjeta" Content="💳 TARJETA" FontSize="14" FontWeight="SemiBold" Margin="0,0,15,0" Checked="MetodoPago_Checked"/>
            <RadioButton x:Name="rbAutoconsumo" Content="📦 AUTOCONSUMO" FontSize="14" FontWeight="SemiBold" Margin="0,0,15,0" Checked="MetodoPago_Checked"/>
            <RadioButton x:Name="rbFiado" Content="📝 FIADO" FontSize="14" FontWeight="SemiBold" Checked="MetodoPago_Checked"/>
        </StackPanel>

        <materialDesign:Card Grid.Row="1" Padding="20" UniformCornerRadius="10" Background="#FFF4FBF5" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="TOTAL A PAGAR" FontSize="16" Foreground="#555" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock x:Name="lblTotalCobrar" Text="$0.00" FontSize="50" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
            </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="2" Padding="20" UniformCornerRadius="10" Margin="0,0,0,20">
            <StackPanel>
                <TextBox x:Name="txtEfectivo" FontSize="30" Height="55" Margin="0,0,0,25" HorizontalContentAlignment="Center" FontWeight="Bold"
                         materialDesign:HintAssist.Hint="Efectivo Recibido ($)" 
                         materialDesign:HintAssist.IsFloating="True"
                         TextChanged="TxtEfectivo_TextChanged"/>

                <Separator Margin="0,0,0,20" Background="#E0E0E0"/>

                <TextBlock Text="SU CAMBIO" FontSize="16" Foreground="#555" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock x:Name="lblCambio" Text="$0.00" FontSize="46" FontWeight="Bold" Foreground="#1976D2" HorizontalAlignment="Center"/>
            </StackPanel>
        </materialDesign:Card>

        <Button x:Name="btnConfirmar" Grid.Row="3" IsDefault="True" Content="❌ EFECTIVO INSUFICIENTE" 
                Background="#D32F2F" BorderBrush="#D32F2F" Foreground="White" FontSize="18" FontWeight="Bold" 
                Height="55" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0.8" 
                Click="BtnConfirmar_Click" materialDesign:ButtonAssist.CornerRadius="8"/>
    </Grid>
</Window>