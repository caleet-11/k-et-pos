<Window x:Class="POS_Presentacion.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Panel de Administración y Finanzas" Height="700" Width="1050" WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        
        Loaded="Window_Loaded">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reporte Financiero" FontSize="28" FontWeight="Light" Margin="0,0,0,25" Foreground="{DynamicResource PrimaryHueMidBrush}"/>

        <materialDesign:Card Grid.Row="1" Padding="20" Margin="0,0,0,25" UniformCornerRadius="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <DatePicker x:Name="dpFechaInicio" Width="180" materialDesign:HintAssist.Hint="Fecha de inicio" Margin="0,0,30,0" FontSize="16"/>
                <DatePicker x:Name="dpFechaFin" Width="180" materialDesign:HintAssist.Hint="Fecha final" Margin="0,0,30,0" FontSize="16"/>

                <Button x:Name="btnGenerar" Content="GENERAR REPORTE" Width="200" Height="45" FontSize="15" Click="BtnGenerar_Click" materialDesign:ButtonAssist.CornerRadius="5"/>
            </StackPanel>
        </materialDesign:Card>

        <Grid Grid.Row="2" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0" Padding="20" UniformCornerRadius="10" Background="#FFF5F8FA">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="CashMultiple" Width="24" Height="24" Foreground="#555" Margin="0,0,10,0"/>
                        <TextBlock Text="INGRESO BRUTO EN CAJA" FontSize="16" Foreground="#555" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="lblIngresoBruto" Text="$0.00" FontSize="42" FontWeight="Bold" Foreground="#1976D2" HorizontalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2" Padding="20" UniformCornerRadius="10" Background="#FFF4FBF5">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="TrendingUp" Width="24" Height="24" Foreground="#555" Margin="0,0,10,0"/>
                        <TextBlock Text="UTILIDAD NETA" FontSize="16" Foreground="#555" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="lblGananciaNeta" Text="$0.00" FontSize="42" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <materialDesign:Card Grid.Row="3" UniformCornerRadius="8" Padding="5">
            <DataGrid x:Name="dgReporte" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="45" HeadersVisibility="Column" Background="White" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Folio" Binding="{Binding FolioVenta}" Width="100"/>
                    <DataGridTextColumn Header="Fecha y Hora" Binding="{Binding FechaHora, StringFormat=dd/MM/yyyy HH:mm}" Width="*"/>
                    <DataGridTextColumn Header="Artículos" Binding="{Binding ArticulosVendidos}" Width="100"/>
                    <DataGridTextColumn Header="Ingreso Bruto" Binding="{Binding IngresoBruto, StringFormat=C}" Width="160"/>
                    <DataGridTextColumn Header="Costo Mercancía" Binding="{Binding CostoTotal, StringFormat=C}" Width="160"/>
                    <DataGridTextColumn Header="Ganancia Neta" Binding="{Binding GananciaNeta, StringFormat=C}" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#2E7D32"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</Window>