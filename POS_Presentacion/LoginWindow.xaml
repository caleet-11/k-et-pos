<Window x:Class="POS_Presentacion.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Iniciar Sesión" Height="550" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="15"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="20">
        <materialDesign:Card Padding="35" UniformCornerRadius="10" VerticalAlignment="Center" Background="White" materialDesign:ElevationAssist.Elevation="Dp4">
            <StackPanel>
                <materialDesign:PackIcon Kind="StorefrontOutline" Width="70" Height="70" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,10"/>

                <TextBlock Text="PUNTO DE VENTA" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,35" Foreground="#333333"/>
                
                <TextBox x:Name="txtUsuario" FontSize="16" Height="45" Margin="0,0,0,25" 
         materialDesign:HintAssist.Hint="👤 Usuario" 
         materialDesign:HintAssist.IsFloating="True" />

                <PasswordBox x:Name="txtPassword" FontSize="16" Height="45" Margin="0,0,0,35" 
             materialDesign:HintAssist.Hint="🔒 Contraseña" 
             materialDesign:HintAssist.IsFloating="True" />

                <Button x:Name="btnLogin" 
        Height="50" 
        Margin="15,20,15,0" 
        Background="#2E7D32" 
        BorderBrush="#2E7D32" 
        Foreground="White" 
        Padding="0"
        IsDefault="True"
        Click="BtnLogin_Click" 
        materialDesign:ButtonAssist.CornerRadius="25">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Login" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="INICIAR SESIÓN" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>