<Window x:Class="POS_Presentacion.ProductoRapidoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Producto Rápido / Genérico" Height="400" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="15"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="20">
        <materialDesign:Card Padding="25" UniformCornerRadius="8" Background="White">
            <StackPanel VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <materialDesign:PackIcon Kind="CartArrowDown" Width="28" Height="28" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Venta Genérica" FontSize="20" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBox x:Name="txtNombre" FontSize="16" Height="45" Margin="0,0,0,20" 
                         materialDesign:HintAssist.Hint="Descripción / Nombre" 
                         materialDesign:HintAssist.IsFloating="True"/>

                <TextBox x:Name="txtPrecio" FontSize="20" Height="50" FontWeight="Bold" Margin="0,0,0,30" 
                         materialDesign:HintAssist.Hint="Precio de Venta ($)" 
                         materialDesign:HintAssist.IsFloating="True" 
                         HorizontalContentAlignment="Right"
                         KeyDown="TxtPrecio_KeyDown"/>

                <Button Background="#2E7D32" BorderBrush="#2E7D32" Foreground="White" 
                        FontWeight="Bold" Height="33" FontSize="15" Click="BtnAgregar_Click" materialDesign:ButtonAssist.CornerRadius="5">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlusCircleOutline" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="AGREGAR AL TICKET" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>