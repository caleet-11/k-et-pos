<Window x:Class="POS_Presentacion.InventarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Gestión de Inventario" WindowState="Maximized" KeyDown="Window_KeyDown"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <materialDesign:Card Grid.Column="0" Padding="20" UniformCornerRadius="8" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="PackageVariantPlus" Width="26" Height="26" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Datos del Producto" FontSize="20" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBox x:Name="txtCodigo" FontSize="15" Margin="0,0,0,15" materialDesign:HintAssist.Hint="Código de Barras" materialDesign:HintAssist.IsFloating="True"/>
                    <TextBox x:Name="txtNombre" FontSize="15" Margin="0,0,0,15" materialDesign:HintAssist.Hint="Descripción / Nombre" materialDesign:HintAssist.IsFloating="True"/>
                    <TextBox x:Name="txtMarca" FontSize="15" Margin="0,0,0,15" materialDesign:HintAssist.Hint="Marca" materialDesign:HintAssist.IsFloating="True"/>
                    <TextBox x:Name="txtProveedor" FontSize="15" Margin="0,0,0,15" materialDesign:HintAssist.Hint="Proveedor" materialDesign:HintAssist.IsFloating="True"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtCosto" Grid.Column="0" FontSize="15" materialDesign:HintAssist.Hint="Precio Costo ($)" materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox x:Name="txtVenta" Grid.Column="2" FontSize="15" materialDesign:HintAssist.Hint="Precio Venta ($)" materialDesign:HintAssist.IsFloating="True"/>
                    </Grid>

                    <CheckBox x:Name="chkControlaStock" Content="Llevar control de stock" IsChecked="True" FontSize="14" Margin="0,5,0,10"/>

                    <TextBox x:Name="txtStock" FontSize="15" Margin="0,0,0,15" materialDesign:HintAssist.Hint="Stock Actual" materialDesign:HintAssist.IsFloating="True"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtStockMinimo" Grid.Column="0" FontSize="15" materialDesign:HintAssist.Hint="Stock Mínimo" materialDesign:HintAssist.IsFloating="True"/>
                        <TextBox x:Name="txtStockIdeal" Grid.Column="2" FontSize="15" materialDesign:HintAssist.Hint="Stock Ideal" materialDesign:HintAssist.IsFloating="True"/>
                    </Grid>

                    <CheckBox x:Name="chkPorPieza" Content="Se vende por unidad (Pieza)" IsChecked="True" FontSize="14" Margin="0,5,0,25"/>

                    <Button x:Name="btnGuardar" Height="45" Margin="0,0,0,12" Click="BtnGuardar_Click" materialDesign:ButtonAssist.CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="GUARDAR PRODUCTO" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnLimpiar" Background="Transparent" BorderBrush="#6C757D" Foreground="#6C757D" Height="40" Click="BtnLimpiar_Click" materialDesign:ButtonAssist.CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Broom" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="LIMPIAR FORMULARIO" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0" Padding="15,5" Margin="0,0,0,15" UniformCornerRadius="8" Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Magnify" Width="24" Height="24" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="txtBuscarInventario" Grid.Column="1" FontSize="16" BorderThickness="0"
                             materialDesign:HintAssist.Hint="Filtrar por descripción, código o marca..." 
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                             TextChanged="TxtBuscarInventario_TextChanged" VerticalAlignment="Center"/>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="1" UniformCornerRadius="8" Padding="5" Background="White">
                <DataGrid x:Name="dgInventario" CanUserResizeColumns="False" AutoGenerateColumns="False" IsReadOnly="True" 
                          RowHeight="45" CanUserAddRows="False" SelectionChanged="DgInventario_SelectionChanged"
                          BorderThickness="0" HeadersVisibility="Column" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="120"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Costo" Binding="{Binding PrecioCosto, StringFormat=C}" Width="90"/>
                        <DataGridTextColumn Header="Ganancia" Binding="{Binding Ganancia, StringFormat=C}" Width="auto"/>
                        <DataGridTextColumn Header="Venta" Binding="{Binding PrecioVenta, StringFormat=C}" Width="90">
                            
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Acciones" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Width="36" Height="32" Margin="4,0" Padding="0"
                                                Background="#FBC02D" BorderBrush="#FBC02D" Foreground="Black"
                                                Click="BtnEditar_Click" ToolTip="Editar Producto"
                                                materialDesign:ButtonAssist.CornerRadius="4"
                                                Style="{StaticResource MaterialDesignRaisedButton}">
                                            <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" VerticalAlignment="Center"/>
                                        </Button>

                                        <Button Width="36" Height="32" Margin="4,0" Padding="0"
                                                Background="#D32F2F" BorderBrush="#D32F2F" Foreground="White"
                                                Click="BtnEliminar_Click" ToolTip="Eliminar Producto"
                                                materialDesign:ButtonAssist.CornerRadius="4"
                                                Style="{StaticResource MaterialDesignRaisedButton}">
                                            <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button x:Name="btnAnterior" Content="◀ ANTERIOR" Click="BtnAnterior_Click" 
                        Width="120" Height="35" Margin="0,0,15,0" 
                        Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#555" BorderBrush="#CCC"/>

                <TextBlock x:Name="lblPaginacion" Text="Página 1 de 1" VerticalAlignment="Center" 
                           FontWeight="SemiBold" FontSize="15" Foreground="#555" Margin="15,0"/>

                <Button x:Name="btnSiguiente" Content="SIGUIENTE ▶" Click="BtnSiguiente_Click" 
                        Width="120" Height="35" Margin="15,0,0,0" 
                        Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#555" BorderBrush="#CCC"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>