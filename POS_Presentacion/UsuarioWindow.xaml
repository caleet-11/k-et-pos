<Window x:Class="POS_Presentacion.UsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Gestión de Usuarios" Height="620" Width="950" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <materialDesign:Card Grid.Column="0" Padding="25" UniformCornerRadius="8" Background="White">
            <StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                    <materialDesign:PackIcon Kind="AccountPlusOutline" Width="28" Height="28" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Nuevo Usuario" FontSize="20" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBox x:Name="txtNombre" FontSize="15" Height="45" Margin="0,0,0,20" 
                         materialDesign:HintAssist.Hint="Nombre Completo" 
                         materialDesign:HintAssist.IsFloating="True"/>

                <TextBox x:Name="txtUsername" FontSize="15" Height="45" Margin="0,0,0,20" 
                         materialDesign:HintAssist.Hint="Usuario (Login)" 
                         materialDesign:HintAssist.IsFloating="True"/>

                <PasswordBox x:Name="txtPassword" FontSize="15" Height="45" Margin="0,0,0,20" 
                             materialDesign:HintAssist.Hint="Contraseña" 
                             materialDesign:HintAssist.IsFloating="True"/>

                <PasswordBox x:Name="txtConfirmar" FontSize="15" Height="45" Margin="0,0,0,20" 
                             materialDesign:HintAssist.Hint="Confirmar Contraseña" 
                             materialDesign:HintAssist.IsFloating="True"/>

                <ComboBox x:Name="cmbRoles" FontSize="15" Height="45" Margin="0,0,0,30" 
                          materialDesign:HintAssist.Hint="Rol del Sistema" 
                          materialDesign:HintAssist.IsFloating="True" 
                          DisplayMemberPath="NombreRol" SelectedValuePath="IdRol"/>

                <Button x:Name="btnGuardar" Height="45" Margin="0,0,0,12" Background="#1976D2" BorderBrush="#1976D2" Click="BtnGuardar_Click" materialDesign:ButtonAssist.CornerRadius="5">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="GUARDAR USUARIO" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnLimpiar" Background="Transparent" BorderBrush="#6C757D" Foreground="#6C757D" Height="40" Click="BtnLimpiar_Click" materialDesign:ButtonAssist.CornerRadius="5">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Broom" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="LIMPIAR CELDAS" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </materialDesign:Card>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0" UniformCornerRadius="8" Padding="5" Background="White" Margin="0,0,0,15">
                <DataGrid x:Name="dgUsuarios" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" 
                          RowHeight="45" BorderThickness="0" HeadersVisibility="Column" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding NumeroFila}" Width="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Login" Binding="{Binding NombreUsuario}" Width="130"/>
                        <DataGridTextColumn Header="Puesto" Binding="{Binding NombreRol}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <Button x:Name="btnEliminar" Grid.Row="1" Background="#D32F2F" BorderBrush="#D32F2F" Foreground="White" 
                    Height="50" Click="BtnEliminar_Click" materialDesign:ButtonAssist.CornerRadius="5">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="DeleteForever" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="ELIMINAR USUARIO SELECCIONADO" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>