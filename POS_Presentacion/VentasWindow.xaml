<Window x:Class="POS_Presentacion.VentasWindow" KeyDown="Window_KeyDown"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Punto de Venta Principal" Height="768" Width="1280" WindowState="Maximized"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="15"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="#F4F6F8"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E2329" Padding="15,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,30,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="MonitorDashboard" Foreground="White" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Ket POS" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#0D6EFD" Padding="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ShoppingOutline" Foreground="White" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Ventas" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="btnF11" Click="BtnF11_Click" Content="Caja (F11)" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#A0AAB5" Height="35" Margin="0,0,5,0"/>
                    <Button x:Name="btnF2" Click="BtnF2_Click" Content="Clientes (F2)" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#A0AAB5" Height="35" Margin="0,0,5,0"/>
                    <Button x:Name="btnF8" Click="BtnF8_Click" Content="Inventario (F8)" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#A0AAB5" Height="35" Margin="0,0,5,0"/>
                    <Button x:Name="btnF10" Click="BtnF10_Click" Content="Historial (F10)" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#A0AAB5" Height="35"/>
                </StackPanel>

                <Button x:Name="btnF12" Grid.Column="3" Click="BtnF12_Click" Content="Info (F12)" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#FBC02D" Height="35"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#2C3E50" Padding="15,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtCodigoBarras" Grid.Column="0" KeyDown="TxtCodigoBarras_KeyDown"
                         Background="White" Foreground="Black" Height="40" FontSize="16" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,15,0"
                         materialDesign:HintAssist.Hint="Escanear Código o Buscar..." materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                    <Button x:Name="btnF3" Click="BtnF3_Click" Height="40" Background="#1976D2" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Buscar (F3)" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnF4" Click="BtnF4_Click" Height="40" Background="#F57C00" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LightningBolt" Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Rápido (F4)" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TabControl x:Name="tabVentas" Grid.Column="2" SelectionChanged="TabVentas_SelectionChanged" Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom" Height="45" Margin="0,0,0,-5">
                    <TabItem Header="Venta 1" Tag="Venta 1" FontSize="15" FontWeight="SemiBold"/>
                    <TabItem Header="Venta 2" Tag="Venta 2" FontSize="15" FontWeight="SemiBold"/>
                    <TabItem Header="Venta 3" Tag="Venta 3" FontSize="15" FontWeight="SemiBold"/>
                </TabControl>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7.5*"/>
                <ColumnDefinition Width="2.5*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="dgTicket" Grid.Row="0" Margin="10" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="55" CanUserAddRows="False"
                          BorderThickness="1" BorderBrush="#E0E0E0" HeadersVisibility="Column" Background="White"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="150" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Descripción del Artículo" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Precio Unit." Binding="{Binding PrecioVenta, StringFormat=C}" Width="130"/>

                        <DataGridTextColumn Header="Cant" Binding="{Binding Cantidad}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#1976D2"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Acciones" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Background="#FBC02D" BorderBrush="#FBC02D" Foreground="Black" Width="35" Height="35" Margin="2" Padding="0" Click="BtnDisminuir_Click" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="Disminuir Cantidad">
                                            <materialDesign:PackIcon Kind="MinusThick" Width="18" Height="18"/>
                                        </Button>
                                        <Button Background="#29B6F6" BorderBrush="#29B6F6" Foreground="Black" Width="35" Height="35" Margin="2" Padding="0" Click="BtnAumentar_Click" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="Aumentar Cantidad">
                                            <materialDesign:PackIcon Kind="PlusThick" Width="18" Height="18"/>
                                        </Button>
                                        <Button Background="#D32F2F" BorderBrush="#D32F2F" Foreground="White" Width="35" Height="35" Margin="2" Padding="0" Click="BtnEliminar_Click" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="Eliminar Renglón">
                                            <materialDesign:PackIcon Kind="DeleteForever" Width="20" Height="20"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,1,0" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnF9" Grid.Column="0" Click="BtnF9_Click" Background="#D32F2F" BorderThickness="0" Foreground="White" Height="50" Width="180" Margin="0,0,15,0" materialDesign:ButtonAssist.CornerRadius="6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cancel" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="CANCELAR (F9)" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnCobrar" Grid.Column="1" Click="BtnCobrar_Click" Background="#2E7D32" BorderThickness="0" Foreground="White" Height="50" Width="180" materialDesign:ButtonAssist.CornerRadius="6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashMultiple" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="COBRAR (ENTER)" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="TOTAL " FontSize="22" FontWeight="SemiBold" Foreground="#6C757D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="lblTotal" Text="$0.00" FontSize="45" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="#E9ECEF" BorderBrush="#DEE2E6" BorderThickness="1,0,0,0">
                <StackPanel Margin="15" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="LightningBolt" Width="40" Height="40" Foreground="#1976D2" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="Acceso Rápido" FontSize="20" FontWeight="Bold" Foreground="#495057" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Agrega tus productos más vendidos aquí y cóbralos con un solo clic sin necesidad de escanear." TextWrapping="Wrap" TextAlignment="Center" Foreground="#6C757D" Margin="0,0,0,25" FontSize="14"/>
                    <Button Content="Configurar Favoritos" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#1976D2" BorderBrush="#1976D2" Height="40" materialDesign:ButtonAssist.CornerRadius="4"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>