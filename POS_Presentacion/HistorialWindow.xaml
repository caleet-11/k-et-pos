<Window x:Class="POS_Presentacion.HistorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Historial y Reimpresión de Tickets" Height="600" Width="1000" 
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        
        WindowState="Maximized"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <materialDesign:Card Grid.Column="0" Padding="15" UniformCornerRadius="8" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ReceiptText" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Historial de Tickets" FontSize="18" FontWeight="SemiBold" Foreground="#555"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                    <DatePicker x:Name="dpInicio" Width="110" Margin="0,0,15,0"/>

                    <TextBlock Text="Hasta:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                    <DatePicker x:Name="dpFin" Width="110" Margin="0,0,15,0"/>

                    <Button x:Name="btnBuscarFechas" Content="🔍 FILTRAR" Width="100" Height="30" 
                            Click="BtnBuscarFechas_Click" Background="#2196F3" Foreground="White" FontWeight="Bold"/>
                </StackPanel>

                <DataGrid x:Name="dgTickets" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" 
                          SelectionChanged="DgTickets_SelectionChanged" RowHeight="40" BorderThickness="0" HeadersVisibility="Column" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="80"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding FechaHora, StringFormat=dd/MM/yyyy HH:mm}" Width="*"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Column="2" Padding="15" UniformCornerRadius="8" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FormatListBulleted" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Artículos Vendidos" FontSize="18" FontWeight="SemiBold" Foreground="#555"/>
                </StackPanel>

                <DataGrid x:Name="dgDetalles" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="40" BorderThickness="0" HeadersVisibility="Column" Background="Transparent">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FueDevuelto}" Value="True">
                                    <Setter Property="Background" Value="#FFF1F0"/>
                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cant" Binding="{Binding Cantidad, StringFormat=0.##}" Width="60"/>
                        <DataGridTextColumn Header="Devuelto" Binding="{Binding CantidadDevuelta, StringFormat=0.##}" Width="90"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C}" Width="100"/>
                        <DataGridTextColumn Header="Margen (%)" Binding="{Binding MargenPorcentaje, StringFormat={}{0:F1} %}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="btnDevolver" Background="#D32F2F" BorderBrush="#D32F2F" Foreground="White" Height="45" Margin="0,0,15,0" Click="BtnDevolver_Click" materialDesign:ButtonAssist.CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="KeyboardReturn" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="DEVOLVER ARTÍCULO" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnReimprimir" Background="#F57C00" BorderBrush="#F57C00" Foreground="White" Height="45" Click="BtnReimprimir_Click" materialDesign:ButtonAssist.CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="REIMPRIMIR TICKET" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>