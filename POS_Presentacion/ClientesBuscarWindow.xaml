<Window x:Class="POS_Presentacion.ClientesBuscarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Buscar Cliente para Fiado" Height="450" Width="550" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}" FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="txtBuscar" Grid.Row="0" FontSize="18" Height="45" Margin="0,0,0,15"
                 materialDesign:HintAssist.Hint="🔍 Buscar cliente por nombre..." 
                 materialDesign:HintAssist.IsFloating="True"
                 TextChanged="TxtBuscar_TextChanged"/>

        <materialDesign:Card Grid.Row="1" UniformCornerRadius="8" Padding="5" Margin="0,0,0,15">
            <DataGrid x:Name="dgClientes" AutoGenerateColumns="False" IsReadOnly="True" 
                      SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                      MouseDoubleClick="DgClientes_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre del Cliente" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTextColumn Header="Deuda Actual" Binding="{Binding DeudaActual, StringFormat=C}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#D32F2F"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <Button x:Name="btnSeleccionar" Grid.Row="2" Content="✅ SELECCIONAR CLIENTE" 
                Background="#2E7D32" BorderBrush="#2E7D32" Foreground="White" Height="45" 
                Click="BtnSeleccionar_Click" materialDesign:ButtonAssist.CornerRadius="8"/>
    </Grid>
</Window>