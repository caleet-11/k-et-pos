<Window x:Class="POS_Presentacion.RegistrarClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Cliente" Height="650" Width="450" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel Margin="5,5,15,5">

                <TextBlock Text="Datos Básicos" FontWeight="Bold" FontSize="14" Foreground="#333" Margin="0,0,0,5"/>
                <Separator Margin="0,0,0,10"/>

                <Label Content="Nombre Completo:" Padding="0,0,0,2"/>
                <TextBox x:Name="txtNombre" MaxLength="100" Padding="4" Margin="0,0,0,10"/>

                <Label Content="Teléfono:" Padding="0,0,0,2"/>
                <TextBox x:Name="txtTelefono" MaxLength="20" Padding="4" Margin="0,0,0,15"/>


                <TextBlock Text="Facturación y Contacto" FontWeight="Bold" FontSize="14" Foreground="#333" Margin="0,10,0,5"/>
                <Separator Margin="0,0,0,10"/>

                <Label Content="Correo Electrónico:" Padding="0,0,0,2"/>
                <TextBox x:Name="txtCorreo" MaxLength="100" Padding="4" Margin="0,0,0,10"/>

                <Label Content="RFC:" Padding="0,0,0,2"/>
                <TextBox x:Name="txtRFC" MaxLength="15" CharacterCasing="Upper" Padding="4" Margin="0,0,0,10"/>

                <Label Content="Dirección:" Padding="0,0,0,2"/>
                <TextBox x:Name="txtDireccion" MaxLength="255" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="4" Margin="0,0,0,15"/>


                <TextBlock Text="Información de Crédito" FontWeight="Bold" FontSize="14" Foreground="#333" Margin="0,10,0,5"/>
                <Separator Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Límite de Crédito ($):" Padding="0,0,0,2"/>
                        <TextBox x:Name="txtLimiteCredito" Text="0.00" Padding="4"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Deuda Actual ($):" Padding="0,0,0,2"/>
                        <TextBox x:Name="txtDeudaActual" Text="0.00" Padding="4" Background="#eee" IsEnabled="False" 
                                 ToolTip="La deuda siempre inicia en $0.00 para clientes nuevos."/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="chkActivo" Content="Cliente Activo" IsChecked="True" FontWeight="SemiBold" Margin="0,10,0,10"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnCancelar" Content="Cancelar" Width="100" Height="35" Margin="0,0,10,0" Background="#f8f9fa" Click="BtnCancelar_Click"/>
            <Button x:Name="btnGuardar" Content="Guardar Cliente" Width="130" Height="35" Background="#0d6efd" Foreground="White" FontWeight="Bold" Click="BtnGuardar_Click"/>
        </StackPanel>

    </Grid>
</Window>